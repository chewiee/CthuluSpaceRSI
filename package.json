{
  "name": "cthuluspace-rsi",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
    "db:init:local": "wrangler d1 execute cthuluspace-rsi --local --file platform/schema.sql",
    "db:init:remote": "wrangler d1 execute cthuluspace-rsi --remote --file platform/schema.sql",
    "check:ritual": "node scripts/check-ritual-diff.mjs",
    "smoke": "node scripts/build.mjs && node tests/smoke.mjs",
    "deploy": "node scripts/build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "wrangler": "4.149.0"
  }
}
